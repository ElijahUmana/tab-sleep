{
  "manifest_version": 3,
  "name": "Tab Sleep",
  "description": "Replaces quiet hidden web tabs with local frozen previews and reloads the live page only when you wake it.",
  "version": "4.2.2",
  "minimum_chrome_version": "150",
  "permissions": [
    "alarms",
    "contextMenus",
    "debugger",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-activity-bridge.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/activity.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Sleep",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "freeze-current-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Freeze the current tab now"
    },
    "freeze-window": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Freeze eligible tabs in this window"
    },
    "wake-all-tabs": {
      "description": "Wake every frozen tab"
    },
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume automatic sleeping"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
